# ═══════════════════════════════════════════════════════════
# Regole per i soli file del sito (cartella /assets/).
#
# Sta qui e non nella cartella principale apposta: sullo stesso
# hosting girano anche /test/ e /api/ (app Noi Club Card), e un
# .htaccess nella principale varrebbe anche per loro.
#
# Ogni blocco e' protetto da <IfModule>: se un modulo manca la
# riga viene ignorata invece di dare errore 500.
# ═══════════════════════════════════════════════════════════

# niente elenco dei file se si apre una cartella
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/css application/javascript text/javascript image/svg+xml
</IfModule>

# Cache lunga: CSS, JS e foto vengono richiamati con un'impronta del
# contenuto (?v=...) aggiunta al deploy, quindi quando cambiano il
# browser li riscarica comunque. I font non cambiano mai.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType text/javascript          "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
